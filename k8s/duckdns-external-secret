apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: duckdns-token
  namespace: cert-manager
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: duckdns-token
    creationPolicy: Owner
  data:
    - secretKey: token
      remoteRef:
        key: bankapp/duckdns-token